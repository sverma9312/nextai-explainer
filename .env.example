# NextAI Explainer — Environment Variables

# Google Gemini API (For Script Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# Neural Voiceover Configuration (Microsoft Edge-TTS)
VIDEO_VOICE_NAME=en-US-AndrewMultilingualNeural
VIDEO_VOICE_RATE=+4%

# Social Media Publishing (Autonomous Mode)
ENABLE_YOUTUBE_PUBLISH=false
ENABLE_INSTAGRAM_PUBLISH=false

# YouTube OAuth2 Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# Instagram Graph API Credentials
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

